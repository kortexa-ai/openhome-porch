{
	"name": "electrobun-react-tailwind-vite",
	"version": "1.0.0",
	"description": "Electrobun app with React, Tailwind CSS, and Vite HMR",
	"type": "module",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build": "vite build && electrobun build --env=stable",
		"build:canary": "vite build && electrobun build --env=canary"
	},
	"dependencies": {
		"@json-render/core": "^0.20.0",
		"@json-render/react": "^0.20.0",
		"@json-render/react-three-fiber": "^0.20.0",
		"@json-render/shadcn": "^0.20.0",
		"@react-three/drei": "^10.7.8",
		"@react-three/fiber": "^9.7.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwindcss-animate": "^1.0.7",
		"three": "^0.185.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/bun": "1.4.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@types/three": "^0.185.4",
		"@vitejs/plugin-react": "^6.1.0",
		"autoprefixer": "^10.5.4",
		"concurrently": "^10.0.5",
		"electrobun": "2.0.1-beta.31",
		"postcss": "^8.5.26",
		"tailwindcss": "^4.3.3",
		"typescript": "6.0.3",
		"vite": "^8.2.2"
	}
}
